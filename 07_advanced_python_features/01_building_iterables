# B. If building a reusable ITERABLE (like list, proper way):
# Here ther is Separation of Concerns:

# First class (Iterable):
# Responsible for storing the data / collection only
# Does not store any iteration state like index or current
# Its only job in **iter** is to create and return a brand new Iterator instance initialized with that data

# Second class (Iterator):
# Responsible for storing the iteration state (pointer/index)
# Its job in **iter** is to return itself
# Its job in **next** is to return the current element, advance the pointer, and raise StopIteration when exhausted

"""
EXAMPLE 1: MyRange
Python
# Iterable - data only
class MyRange:
    def __init__(self, stop):
        self.stop = stop
    def __iter__(self):
        return MyRangeIterator(self.stop)

# Iterator - data + pointer
class MyRangeIterator:
    def __init__(self, stop):
        self.stop = stop
        self.current = 0
    def __iter__(self):
        return self
    def __next__(self):
        if self.current >= self.stop:
            raise StopIteration
        v = self.current
        self.current += 1
        return v


