    def __init__(self, n):
        self.n = n
        self.index = 0
    def __iter__(self):
        return self
    def __next__(self):
        if self.index >= len(self.n):
            raise StopIteration
        v = self.n[self.index] ** 2
        self.index += 1
        return v

