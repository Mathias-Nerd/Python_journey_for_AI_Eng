# GENERAL ALGORITHM FOR CUSTOM ITERABLE / ITERATOR
# A. If building an ITERATOR (one-time use):
# 1. Create the class for the iterator
# 2. In **init**, store your data AND create a pointer (e.g index = 0).
# 3. In **iter**, return self.
# 4. In **next**:
#      a. Check if pointer is past the end -> if yes, raise StopIteration
#      b. Get item at pointer
#       c. Move pointer forward by 1
#       d. Return item
#Result: Can only loop once. Exhausted after.

"""
EXAMPLE 1: Countdown
Counts from start down to 1.

Python
class Countdown:
    def __init__(self, start):
        self.current = start

    def __iter__(self):
        return self

    def __next__(self):
        if self.current <= 0:
            raise StopIteration
        value = self.current
        self.current -= 1
        return value

# Usage
for n in Countdown(3):
    print(n)  # 3, 2, 1

State is self.current. It moves backwards.
